# API server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://triageai:triageai@localhost:5432/triageai

# AI service (Python/FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Auth (Phase 9). Leave AUTH_MODE unset to choose it in the /config wizard;
# setting it here pins it (env always wins). Default when unset: disabled in
# development, required in production.
# AUTH_MODE=disabled
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=2592000

# Browser origins allowed by CORS (comma-separated; `*` reflects any origin —
# never with AUTH_MODE=disabled on a reachable host)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Static bearer token Prometheus presents for GET /metrics when AUTH_MODE=required
# METRICS_TOKEN=replace-with-at-least-16-random-characters

# Rate limiting (per client IP; auth routes have a stricter window)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute
# RATE_LIMIT_DISABLED=1   # tests only
# TRIAGEAI_TRUST_PROXY=loopback, linklocal, uniquelocal  # behind compose nginx

# Optional: override the local generator endpoint (Ollama / LM Studio / OpenAI-compatible)
# Local host: http://localhost:11434 · Compose stack: http://ollama:11434
# TRIAGEAI_GENERATOR_BASE_URL=http://localhost:11434

# First-run setup wizard (Phase 11). TRIAGEAI_SETUP=off skips the wizard for
# env/file-driven deployments. The encrypted secret store is on by default:
# without TRIAGEAI_SECRET_KEY the API generates data/secrets/master.key (or
# $TRIAGEAI_SECRETS_DIR/master.key, mode 600). Back that file up separately from
# database backups; the env key wins when set.
# TRIAGEAI_SETUP=auto
# TRIAGEAI_SECRET_KEY=replace-with-at-least-32-random-characters
# TRIAGEAI_SECRETS_DIR=/data/secrets
# TRIAGEAI_RESTART_ON_APPLY=0

# App updates (About /config). Checks GitHub at most every 14 days. Downloads
# are staged under TRIAGEAI_UPDATE_DIR; an operator-configured command is the
# only thing that can apply them (never auto-execute downloaded code).
# TRIAGEAI_UPDATE_DIR=/data/updates
# TRIAGEAI_UPDATE_ROOT=/app
# TRIAGEAI_UPDATE_COMMAND=git pull --ff-only && pnpm install --frozen-lockfile && pnpm build
