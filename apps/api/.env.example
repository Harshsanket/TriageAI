# API server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://triageai:triageai@localhost:5432/triageai

# Redis (used from Phase 1 for BullMQ workers)
REDIS_URL=redis://localhost:6379

# AI service (Python/FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Auth (Phase 9). Development/test default: disabled. Production defaults to
# required and refuses to boot without a >=32-character secret.
AUTH_MODE=disabled
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=2592000

# Rate limiting (per client IP; auth routes have a stricter window)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute
# RATE_LIMIT_DISABLED=1   # tests only

# Optional: override the local generator endpoint (Ollama / LM Studio / OpenAI-compatible)
# Local host: http://localhost:11434 · Compose stack: http://ollama:11434
# TRIAGEAI_GENERATOR_BASE_URL=http://localhost:11434
