{
  "name": "@triageai/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:retrieval": "tsx evals/retrieval.eval.ts",
    "eval:generation": "tsx evals/generation.eval.ts",
    "eval:merge": "tsx evals/merge.eval.ts",
    "eval:fixtures": "tsx evals/exportFixtures.eval.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@triageai/contracts": "workspace:*",
    "@triageai/kernel": "workspace:*",
    "@triageai/module-ai-pipeline": "workspace:*",
    "@triageai/module-chat": "workspace:*",
    "@triageai/module-doc-assistant": "workspace:*",
    "@triageai/module-echo": "workspace:*",
    "@triageai/module-integrations-github": "workspace:*",
    "@triageai/module-integrations-slack": "workspace:*",
    "@triageai/module-kb": "workspace:*",
    "@triageai/module-support": "workspace:*",
    "@triageai/rag": "workspace:*",
    "fastify": "^5.6.1",
    "jose": "^6.2.13",
    "pino": "^9.13.1",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
